# ─────────────────────────────────────────────────────────────
#  HiraAgency Workspace — environment template
#  Copy to `.env.local` and fill in. Never commit `.env.local`.
#    PowerShell:  Copy-Item .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ─── Database (Neon Postgres) ────────────────────────────────
# Neon Dashboard → Project → Connect → toggle "Connection pooling" ON.
# The pooled host contains a `-pooler` segment in the hostname.
# Prisma 7 uses a driver adapter, so no `pgbouncer=true` flag is needed.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Migrations and `prisma studio` use the DIRECT (unpooled) host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js v5 ──────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
# (Windows PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })))
AUTH_SECRET=""

# Auth.js derives the origin from the incoming request. Do NOT set AUTH_URL —
# a localhost value deployed to Vercel is what sends login/logout to localhost.
AUTH_TRUST_HOST="true"

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="HiraAgency Workspace"

# Timezone of record for workday boundaries. Do not change after go-live —
# it would shift every historical attendance date.
APP_TIMEZONE="Asia/Manila"

# How many days back a member may backdate a submission.
MAX_BACKDATE_DAYS="7"

# ─── Seed script (prisma/seed.ts only) ───────────────────────
# Used once to bootstrap the first admin account.
SEED_ADMIN_EMAIL="admin@hiraagency.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD=""

# ─── Neon Object Storage (S3-compatible) ─────────────────────
# Branch endpoint, region and a storage:read + storage:write credential.
# Create the bucket (private) in the Neon console, then:
#   neon credentials create --scope storage:read --scope storage:write
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-2.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""      # credential token_id
AWS_SECRET_ACCESS_KEY=""  # credential s3_secret_access_key
NEON_STORAGE_BUCKET="hira-media"

# ─── Optional / not wired up yet ─────────────────────────────
# Email provider for magic links, password resets, daily digests.
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@hiraagency.com"
