// HiraAgency Workspace — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum ProjectRole {
  LEAD
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
}

// ─────────────────────────────────────────────────────────────
//  Auth
// ─────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  image              String?
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     ProjectMember[] @relation("MembershipUser")
  addedMembers    ProjectMember[] @relation("MembershipAdder")
  attendance      Attendance[]
  submissions     Submission[]    @relation("Author")
  reviews         Submission[]    @relation("Reviewer")
  createdProjects Project[]       @relation("ProjectCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
//  Domain
// ─────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  color       String        @default("#22C55E")
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members     ProjectMember[]
  submissions Submission[]

  @@index([status])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  addedById String?
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("MembershipAdder", fields: [addedById], references: [id])

  @@id([projectId, userId])
  @@index([userId])
}

/// One row per user per Manila calendar day.
model Attendance {
  id         String    @id @default(cuid())
  userId     String
  workDate   DateTime  @db.Date
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  note       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([workDate])
}

model Submission {
  id           String           @id @default(cuid())
  authorId     String
  projectId    String
  workDate     DateTime         @db.Date
  title        String
  notes        String?
  status       SubmissionStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  author   User             @relation("Author", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer User?            @relation("Reviewer", fields: [reviewedById], references: [id])
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links    SubmissionLink[]

  @@index([projectId, workDate])
  @@index([authorId, workDate])
  @@index([status])
}

model SubmissionLink {
  id           String  @id @default(cuid())
  submissionId String
  url          String
  platform     String?
  label        String?
  position     Int     @default(0)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
